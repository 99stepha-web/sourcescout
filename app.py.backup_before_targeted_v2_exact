# ==================================================
# KEYWORD RESEARCH
# ==================================================

if research_mode == "🔍 Keyword Research":

    research_col1, research_col2 = st.columns(
        [3, 1]
    )


    with research_col1:

        targeted_keyword = st.text_input(
            "Product or niche",
            placeholder=(
                "Example: peptide serum, portable "
                "espresso maker, mini projector"
            ),
            key="targeted_research_keyword",
        )


    with research_col2:

        targeted_source = st.selectbox(
            "Research source",
            [
                "Alibaba",
                "Taobao",
            ],
            key="targeted_research_source",
        )


    targeted_limit = st.slider(
        "Maximum research results",
        min_value=5,
        max_value=50,
        value=20,
        step=5,
        key="targeted_research_limit",
    )


    if targeted_source == "Taobao":

        st.info(
            "Taobao is currently available as a research "
            "source placeholder. Automated Taobao discovery "
            "will be connected in a later patch. No fake "
            "results will be generated."
        )


    run_targeted_research = st.button(
        "🎯 Start Targeted Research",
        type="primary",
        key="run_targeted_keyword_research",
        use_container_width=True,
    )


    if run_targeted_research:

        keyword = (
            targeted_keyword
            or ""
        ).strip()


        if not keyword:

            st.warning(
                "Enter a product or niche to research."
            )


        elif targeted_source == "Taobao":

            st.session_state[
                "targeted_research_results"
            ] = []

            st.session_state[
                "targeted_research_context"
            ] = {
                "keyword": keyword,
                "source": targeted_source,
            }


            st.warning(
                "The Taobao connector is not active yet. "
                "Your research query is ready, but SourceScout "
                "will not invent marketplace results."
            )


        else:

            try:

                with st.spinner(
                    f"Researching {keyword} "
                    f"on {targeted_source}..."
                ):

                    results = discover_products(
                        marketplace=targeted_source,
                        keyword=keyword,
                        limit=targeted_limit,
                    )


                st.session_state[
                    "targeted_research_results"
                ] = results or []

                st.session_state[
                    "targeted_research_context"
                ] = {
                    "keyword": keyword,
                    "source": targeted_source,
                }


                if results:

                    st.success(
                        f"Found {len(results)} "
                        "targeted research candidate(s)."
                    )

                else:

                    st.info(
                        "No products were returned for "
                        "this research query."
                    )


            except Exception as error:

                st.error(
                    "Targeted research failed: "
                    f"{error}"
                )


    # --------------------------------------------------
    # Display targeted research results
    # --------------------------------------------------

    targeted_results = st.session_state.get(
        "targeted_research_results",
        [],
    )

    targeted_context = st.session_state.get(
        "targeted_research_context",
        {},
    )


    if targeted_results:

        st.markdown(
            "### 🔎 Research Candidates"
        )

        st.caption(
            "Review the candidates before importing them. "
            "Imported products will continue through the "
            "normal SourceScout scoring pipeline."
        )


        selected_targeted_products = []


        for index, result in enumerate(
            targeted_results
        ):

            with st.container(
                border=True
            ):

                select_candidate = st.checkbox(
                    "Select for import",
                    key=(
                        "targeted_candidate_"
                        f"{index}"
                    ),
                )


                title = (
                    result.get("title")
                    or result.get("name")
                    or "Untitled product"
                )


                image_url = (
                    result.get(
                        "image_url"
                    )
                    or result.get(
                        "image"
                    )
                    or result.get(
                        "thumbnail"
                    )
                )


                if image_url:

                    st.image(
                        image_url,
                        width=220,
                    )


                st.markdown(
                    f"### {title}"
                )


                detail_col1, detail_col2 = (
                    st.columns(2)
                )


                with detail_col1:

                    if result.get("price") is not None:

                        st.write(
                            "**Price:** "
                            f"{result.get('price')}"
                        )


                    if result.get("orders") is not None:

                        st.write(
                            "**Orders / Sales:** "
                            f"{result.get('orders')}"
                        )


                    supplier = (
                        result.get(
                            "supplier"
                        )
                        or result.get(
                            "shop_name"
                        )
                        or result.get(
                            "seller"
                        )
                    )


                    if supplier:

                        st.write(
                            "**Seller / Shop:** "
                            f"{supplier}"
                        )


                with detail_col2:

                    if result.get("rating") is not None:

                        st.write(
                            "**Rating:** "
                            f"{result.get('rating')}"
                        )


                    st.write(
                        "**Research source:** "
                        f"{targeted_context.get('source', '')}"
                    )


                    has_video = bool(
                        result.get(
                            "has_video"
                        )
                        or result.get(
                            "has_demo_video"
                        )
                        or result.get(
                            "video_url"
                        )
                    )


                    st.write(
                        "**Demo video:** "
                        + (
                            "✅ Available"
                            if has_video
                            else "— Not detected"
                        )
                    )


                    if result.get(
                        "trend_score"
                    ) is not None:

                        st.write(
                            "**Trend Score:** "
                            f"{result.get('trend_score')}"
                        )


                product_url = (
                    result.get("product_url")
                    or result.get("url")
                )


                if product_url:

                    st.link_button(
                        "🔗 Open Marketplace Product",
                        product_url,
                        key=(
                            "targeted_open_"
                            f"{index}"
                        ),
                    )


                if select_candidate:

                    selected_targeted_products.append(
                        result
                    )


        if selected_targeted_products:

            st.info(
                f"{len(selected_targeted_products)} "
                "candidate(s) selected."
            )


            if st.button(
                "📥 Import Selected Research Products",
                type="primary",
                key="import_targeted_products",
                use_container_width=True,
            ):

                imported_count = 0
                failed_count = 0


                for result in (
                    selected_targeted_products
                ):

                    try:

                        import_result = ingest_product(
                            result
                        )


                        if import_result:

                            imported_product_id = (
                                import_result.get(
                                    "product_id"
                                )
                            )


                            current_product = (
                                db.query(Product)
                                .filter(
                                    Product.id
                                    == imported_product_id
                                )
                                .first()
                            )


                            if current_product:

                                current_product.research_keyword = (
                                    targeted_context.get(
                                        "keyword"
                                    )
                                )

                                current_product.discovery_source = (
                                    targeted_context.get(
                                        "source"
                                    )
                                )

                                current_product.source_product_url = (
                                    result.get(
                                        "product_url"
                                    )
                                    or result.get(
                                        "url"
                                    )
                                )


                                current_product.has_demo_video = bool(
                                    result.get(
                                        "has_video"
                                    )
                                    or result.get(
                                        "has_demo_video"
                                    )
                                    or result.get(
                                        "video_url"
                                    )
                                )


                                current_product.trend_score = (
                                    result.get(
                                        "trend_score",
                                        0,
                                    )
                                    or 0
                                )


                                current_product.video_potential_score = (
                                    result.get(
                                        "video_potential_score",
                                        0,
                                    )
                                    or 0
                                )


                                current_product.cross_marketplace_status = (
                                    "not_checked"
                                )


                                db.commit()


                            imported_count += 1


                    except Exception as error:

                        db.rollback()

                        failed_count += 1

                        st.error(
                            "Could not import "
                            f"{result.get('title', 'product')}: "
                            f"{error}"
                        )


                if imported_count:

                    st.success(
                        f"✅ {imported_count} targeted "
                        "product(s) imported."
                    )


                if failed_count:

                    st.warning(
                        f"⚠️ {failed_count} import(s) failed."
                    )


                if imported_count:

                    st.session_state[
                        "targeted_research_results"
                    ] = []

                    st.rerun()


