# ==================================================
# BULK CLAUDE ANALYSIS
# ==================================================

with automation_col1:

    if st.button(
        (
            "🤖 Analyze Qualifying Products "
            f"({len(unanalyzed_high_potential)})"
        ),
        key="bulk_claude_analysis",
        disabled=(
            len(
                unanalyzed_high_potential
            )
            == 0
        ),
        use_container_width=True,
    ):

        analysis_completed = 0
        analysis_failed = 0

        progress = st.progress(
            0
        )

        status_box = st.empty()

        total = len(
            unanalyzed_high_potential
        )


        for index, product in enumerate(
            unanalyzed_high_potential,
            start=1,
        ):

            status_box.write(
                f"Analyzing {index}/{total}: "
                f"{product.title}"
            )


            try:

                current_product = (
                    db.query(Product)
                    .filter(
                        Product.id
                        == product.id
                    )
                    .first()
                )


                if current_product:

                    analyze_and_save_product(
                        db,
                        current_product,
                    )

                    analysis_completed += 1


            except Exception as error:

                db.rollback()

                analysis_failed += 1

                st.error(
                    "Claude analysis failed for "
                    f"{product.title}: {error}"
                )


            progress.progress(
                index / total
            )


        status_box.empty()


        if analysis_completed:

            st.success(
                f"{analysis_completed} product(s) "
                "analyzed successfully."
            )


        if analysis_failed:

            st.warning(
                f"{analysis_failed} product(s) failed."
            )


        st.rerun()


