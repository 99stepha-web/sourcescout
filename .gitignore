# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual Environment
.venv/
venv/
env/

# Environment Variables
.env
.env.*

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Build
build/
dist/
*.egg-info/

# Logs
*.log

# Local SQLite databases
data/*.db
*.sqlite
*.sqlite3

# Streamlit cache
.streamlit/secrets.toml

# Temporary files
*.tmp
*.swp
google_credentials.json
google_token.json

# Debug/scratch artifacts from development sessions
*.backup
*.backup_*
promotion_clipboard.txt
promotion_debug.txt
card.html
goods_card.html
