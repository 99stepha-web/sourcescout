                            f"{shortlist_product.supplier}"
                        )


                    if getattr(
                        shortlist_product,
                        "moq",
                        None,
                    ):

                        st.write(
                            "**MOQ:** "
                            f"{shortlist_product.moq}"
                        )


                with score_column:

                    st.metric(
                        "Opportunity Score",
                        shortlist_product.opportunity_score,
                    )


                if select_for_ai:

                    selected_shortlist_products.append(
                        shortlist_product
                    )


        # ------------------------------------------
        # Claude batch analysis
        # ------------------------------------------

        if selected_shortlist_products:

            selected_count = len(
                selected_shortlist_products
            )


            if selected_count > batch_limit:

                st.warning(
                    f"You selected {selected_count} products, "
                    f"but the current batch limit is {batch_limit}. "
                    "Reduce the selection or increase the batch limit."
                )


            else:

                st.info(
                    f"{selected_count} product(s) selected "
                    "for Claude analysis."
                )


                if st.button(
                    "🤖 Analyze Selected with Claude",
                    type="primary",
                    key="analyze_shortlisted_products",
                ):

                    completed = 0
                    failed = 0

                    progress_bar = st.progress(
                        0
                    )

                    status_message = st.empty()


                    for index, shortlist_product in enumerate(
                        selected_shortlist_products,
                        start=1,
                    ):

                        status_message.write(
                            "Analyzing "
                            f"{index}/{selected_count}: "
                            f"{shortlist_product.title}"
                        )


                        try:

                            # Use the main application
                            # database session.

                            current_product = (
                                db.query(Product)
                                .filter(
                                    Product.id
                                    == shortlist_product.id
                                )
                                .first()
                            )


                            if current_product:

                                analyze_and_save_product(
                                    db,
                                    current_product,
                                )

                                completed += 1


                        except Exception as error:

                            failed += 1

                            st.error(
                                "Claude analysis failed for "
                                f"{shortlist_product.title}: "
                                f"{error}"
                            )


                        progress_bar.progress(
                            index / selected_count
                        )


                    status_message.empty()


                    if completed:

                        st.success(
                            f"✅ {completed} product(s) "
                            "analyzed successfully."
                        )


                    if failed:

                        st.warning(
                            f"⚠️ {failed} product(s) failed."
                        )


                    st.rerun()


