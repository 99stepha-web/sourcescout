                    st.image(
                        image_url,
                        use_container_width=True,
                    )

                else:

                    st.info(
                        "No product image"
                    )


            # ------------------------------------------
            # Product information
            # ------------------------------------------

            with details_column:

                st.markdown(
                    f"### {title}"
                )


                st.markdown(
                    f"**Supplier:** {supplier}"
                )


                st.markdown(
                    f"**Minimum Order:** {moq}"
                )


                if product_url:

                    st.link_button(
                        "🔗 View Product on Alibaba",
                        product_url,
                    )


            # ------------------------------------------
            # Product metrics
            # ------------------------------------------

            (
                price_column,
                orders_column,
                rating_column,
                moq_column,
            ) = st.columns(4)


            price_column.metric(
                "Starting Price",
                f"${price:,.2f}",
            )


            orders_column.metric(
                "Orders",
                f"{orders:,}",
            )


            rating_column.metric(
                "Rating",
                f"{rating}/5",
            )


            moq_column.metric(
                "MOQ",
                str(moq),
            )


            # ------------------------------------------
            # Price context warning
            # ------------------------------------------

            if price <= 1:

                st.caption(
                    "⚠️ Alibaba prices may represent "
                    "a unit, component, watt, sample, "
                    "or volume-based starting price. "
                    "Check the listing before scoring "
                    "this product."
                )


            if select_product:

                selected_products.append(
                    item
                )


    if selected_products:

        if st.button(
            "📥 Import Selected Products",
            type="primary",
        ):

            try:

                with st.spinner(
                    "Importing selected products..."
                ):

                    import_result = (
                        ingest_products(
                            selected_products
                        )
                    )


                st.success(
                    "Product import completed."
                )


                metric1, metric2, metric3 = (
                    st.columns(3)
                )


                metric1.metric(
                    "Created",
                    import_result[
                        "created"
                    ],
                )


                metric2.metric(
                    "Updated",
                    import_result[
                        "updated"
                    ],
                )


                metric3.metric(
                    "Failed",
                    import_result[
                        "failed"
                    ],
                )


            except Exception as error:

                st.error(
                    f"Import failed: {error}"
                )
